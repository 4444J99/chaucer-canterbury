  "work_id": "BLIND_H1",
  "title": "General Prologue, lines 1-200 (Skeat 1900)",
  "stanzas": [
    {
      "stanza_id": "GP.C001",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.1",
          "line_number": 1,
          "text": "Whan that Aprille with his shoures sote",
          "contested": false
        },
        {
          "ref": "GP.2",
          "line_number": 2,
          "text": "The droghte of Marche hath perced to the rote,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C002",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.3",
          "line_number": 3,
          "text": "And bathed every veyne in swich licour,",
          "contested": false
        },
        {
          "ref": "GP.4",
          "line_number": 4,
          "text": "Of which vertu engendred is the flour;",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C003",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.5",
          "line_number": 5,
          "text": "Whan Zephirus eek with his swete breeth",
          "contested": false
        },
        {
          "ref": "GP.6",
          "line_number": 6,
          "text": "Inspired hath in every holt and heeth",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C004",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.7",
          "line_number": 7,
          "text": "The tendre croppes, and the yonge sonne",
          "contested": false
        },
        {
          "ref": "GP.8",
          "line_number": 8,
          "text": "Hath in the Ram his halfe cours y-ronne,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C005",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.9",
          "line_number": 9,
          "text": "And smale fowles maken melodye,",
          "contested": false
        },
        {
          "ref": "GP.10",
          "line_number": 10,
          "text": "That slepen al the night with open yë,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C006",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.11",
          "line_number": 11,
          "text": "(So priketh hem nature in hir corages):",
          "contested": false
        },
        {
          "ref": "GP.12",
          "line_number": 12,
          "text": "Than longen folk to goon on pilgrimages",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C007",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.13",
          "line_number": 13,
          "text": "(And palmers for to seken straunge strondes)",
          "contested": false
        },
        {
          "ref": "GP.14",
          "line_number": 14,
          "text": "To ferne halwes, couthe in sondry londes;",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C008",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.15",
          "line_number": 15,
          "text": "And specially, from every shires ende",
          "contested": false
        },
        {
          "ref": "GP.16",
          "line_number": 16,
          "text": "Of Engelond, to Caunterbury they wende,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C009",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.17",
          "line_number": 17,
          "text": "The holy blisful martir for to seke,",
          "contested": false
        },
        {
          "ref": "GP.18",
          "line_number": 18,
          "text": "That hem hath holpen, whan that they were seke.",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C010",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.19",
          "line_number": 19,
          "text": "Bifel that, in that seson on a day,",
          "contested": false
        },
        {
          "ref": "GP.20",
          "line_number": 20,
          "text": "In Southwerk at the Tabard as I lay",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C011",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.21",
          "line_number": 21,
          "text": "Redy to wenden on my pilgrimage",
          "contested": false
        },
        {
          "ref": "GP.22",
          "line_number": 22,
          "text": "To Caunterbury with ful devout corage,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C012",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.23",
          "line_number": 23,
          "text": "At night was come in-to that hostelrye",
          "contested": false
        },
        {
          "ref": "GP.24",
          "line_number": 24,
          "text": "Wel nyne and twenty in a companye,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C013",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.25",
          "line_number": 25,
          "text": "Of sondry folk, by aventure y-falle",
          "contested": false
        },
        {
          "ref": "GP.26",
          "line_number": 26,
          "text": "In felawshipe, and pilgrims were they alle,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C014",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.27",
          "line_number": 27,
          "text": "That toward Caunterbury wolden ryde;",
          "contested": false
        },
        {
          "ref": "GP.28",
          "line_number": 28,
          "text": "The chambres and the stables weren wyde,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C015",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.29",
          "line_number": 29,
          "text": "And wel we weren esed atte beste.",
          "contested": false
        },
        {
          "ref": "GP.30",
          "line_number": 30,
          "text": "And shortly, whan the sonne was to reste,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C016",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.31",
          "line_number": 31,
          "text": "So hadde I spoken with hem everichon,",
          "contested": false
        },
        {
          "ref": "GP.32",
          "line_number": 32,
          "text": "That I was of hir felawshipe anon,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C017",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.33",
          "line_number": 33,
          "text": "And made forward erly for to ryse,",
          "contested": false
        },
        {
          "ref": "GP.34",
          "line_number": 34,
          "text": "To take our wey, ther as I yow devyse.",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C018",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.35",
          "line_number": 35,
          "text": "But natheles, whyl I have tyme and space,",
          "contested": false
        },
        {
          "ref": "GP.36",
          "line_number": 36,
          "text": "Er that I ferther in this tale pace,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C019",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.37",
          "line_number": 37,
          "text": "Me thinketh it acordaunt to resoun,",
          "contested": false
        },
        {
          "ref": "GP.38",
          "line_number": 38,
          "text": "To telle yow al the condicioun",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C020",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.39",
          "line_number": 39,
          "text": "Of ech of hem, so as it semed me,",
          "contested": false
        },
        {
          "ref": "GP.40",
          "line_number": 40,
          "text": "And whiche they weren, and of what degree;",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C021",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.41",
          "line_number": 41,
          "text": "And eek in what array that they were inne:",
          "contested": false
        },
        {
          "ref": "GP.42",
          "line_number": 42,
          "text": "And at a knight than wol I first biginne.",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C022",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.43",
          "line_number": 43,
          "text": "A KNIGHT ther was, and that a worthy man,",
          "contested": false
        },
        {
          "ref": "GP.44",
          "line_number": 44,
          "text": "That fro the tyme that he first bigan",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C023",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.45",
          "line_number": 45,
          "text": "To ryden out, he loved chivalrye,",
          "contested": false
        },
        {
          "ref": "GP.46",
          "line_number": 46,
          "text": "Trouthe and honour, fredom and curteisye.",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C024",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.47",
          "line_number": 47,
          "text": "Ful worthy was he in his lordes werre,",
          "contested": false
        },
        {
          "ref": "GP.48",
          "line_number": 48,
          "text": "And therto hadde he riden (no man ferre)",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C025",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.49",
          "line_number": 49,
          "text": "As wel in Cristendom as hethenesse,",
          "contested": false
        },
        {
          "ref": "GP.50",
          "line_number": 50,
          "text": "And ever honoured for his worthinesse.",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C026",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.51",
          "line_number": 51,
          "text": "At Alisaundre he was, whan it was wonne;",
          "contested": false
        },
        {
          "ref": "GP.52",
          "line_number": 52,
          "text": "Ful ofte tyme he hadde the bord bigonne",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C027",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.53",
          "line_number": 53,
          "text": "Aboven alle naciouns in Pruce.",
          "contested": false
        },
        {
          "ref": "GP.54",
          "line_number": 54,
          "text": "In Lettow hadde he reysed and in Ruce,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C028",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.55",
          "line_number": 55,
          "text": "No Cristen man so ofte of his degree.",
          "contested": false
        },
        {
          "ref": "GP.56",
          "line_number": 56,
          "text": "In Gernade at the sege eek hadde he be",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C029",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.57",
          "line_number": 57,
          "text": "Of Algezir, and riden in Belmarye.",
          "contested": false
        },
        {
          "ref": "GP.58",
          "line_number": 58,
          "text": "At Lyeys was he, and at Satalye,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C030",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.59",
          "line_number": 59,
          "text": "Whan they were wonne; and in the Grete See",
          "contested": false
        },
        {
          "ref": "GP.60",
          "line_number": 60,
          "text": "At many a noble aryve hadde he be.",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C031",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.61",
          "line_number": 61,
          "text": "At mortal batailles hadde he been fiftene,",
          "contested": false
        },
        {
          "ref": "GP.62",
          "line_number": 62,
          "text": "And foughten for our feith at Tramissene",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C032",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.63",
          "line_number": 63,
          "text": "In listes thryes, and ay slayn his foo.",
          "contested": false
        },
        {
          "ref": "GP.64",
          "line_number": 64,
          "text": "This ilke worthy knight had been also",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C033",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.65",
          "line_number": 65,
          "text": "Somtyme with the lord of Palatye,",
          "contested": false
        },
        {
          "ref": "GP.66",
          "line_number": 66,
          "text": "Ageyn another hethen in Turkye:",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C034",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.67",
          "line_number": 67,
          "text": "And evermore he hadde a sovereyn prys.",
          "contested": false
        },
        {
          "ref": "GP.68",
          "line_number": 68,
          "text": "And though that he were worthy, he was wys,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C035",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.69",
          "line_number": 69,
          "text": "And of his port as meke as is a mayde.",
          "contested": false
        },
        {
          "ref": "GP.70",
          "line_number": 70,
          "text": "He never yet no vileinye ne sayde",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C036",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.71",
          "line_number": 71,
          "text": "In al his lyf, un-to no maner wight.",
          "contested": false
        },
        {
          "ref": "GP.72",
          "line_number": 72,
          "text": "He was a verray parfit gentil knight.",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C037",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.73",
          "line_number": 73,
          "text": "But for to tellen yow of his array,",
          "contested": false
        },
        {
          "ref": "GP.74",
          "line_number": 74,
          "text": "His hors were gode, but he was nat gay.",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C038",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.75",
          "line_number": 75,
          "text": "Of fustian he wered a gipoun",
          "contested": false
        },
        {
          "ref": "GP.76",
          "line_number": 76,
          "text": "Al bismotered with his habergeoun;",
          "contested": true,
          "contested_reason": "Irregular initial/syncopated scansion ('Al bismotered with his habergeoun'); noted in Benson p. xliv."
        }
      ]
    },
    {
      "stanza_id": "GP.C039",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.77",
          "line_number": 77,
          "text": "For he was late y-come from his viage,",
          "contested": false
        },
        {
          "ref": "GP.78",
          "line_number": 78,
          "text": "And wente for to doon his pilgrimage.",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C040",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.79",
          "line_number": 79,
          "text": "With him ther was his sone, a yong SQUYER,",
          "contested": false
        },
        {
          "ref": "GP.80",
          "line_number": 80,
          "text": "A lovyere, and a lusty bacheler,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C041",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.81",
          "line_number": 81,
          "text": "With lokkes crulle, as they were leyd in presse.",
          "contested": false
        },
        {
          "ref": "GP.82",
          "line_number": 82,
          "text": "Of twenty yeer of age he was, I gesse.",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C042",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.83",
          "line_number": 83,
          "text": "Of his stature he was of evene lengthe,",
          "contested": false
        },
        {
          "ref": "GP.84",
          "line_number": 84,
          "text": "And wonderly deliver, and greet of strengthe.",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C043",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.85",
          "line_number": 85,
          "text": "And he had been somtyme in chivachye,",
          "contested": false
        },
        {
          "ref": "GP.86",
          "line_number": 86,
          "text": "In Flaundres, in Artoys, and Picardye,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C044",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.87",
          "line_number": 87,
          "text": "And born him wel, as of so litel space,",
          "contested": false
        },
        {
          "ref": "GP.88",
          "line_number": 88,
          "text": "In hope to stonden in his lady grace.",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C045",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.89",
          "line_number": 89,
          "text": "Embrouded was he, as it were a mede",
          "contested": false
        },
        {
          "ref": "GP.90",
          "line_number": 90,
          "text": "Al ful of fresshe floures, whyte and rede.",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C046",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.91",
          "line_number": 91,
          "text": "Singinge he was, or floytinge, al the day;",
          "contested": false
        },
        {
          "ref": "GP.92",
          "line_number": 92,
          "text": "He was as fresh as is the month of May.",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C047",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.93",
          "line_number": 93,
          "text": "Short was his goune, with sleves longe and wyde.",
          "contested": false
        },
        {
          "ref": "GP.94",
          "line_number": 94,
          "text": "Wel coude he sitte on hors, and faire ryde.",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C048",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.95",
          "line_number": 95,
          "text": "He coude songes make and wel endyte,",
          "contested": false
        },
        {
          "ref": "GP.96",
          "line_number": 96,
          "text": "Iuste and eek daunce, and wel purtreye and wryte,",
          "contested": false
        }
      ]
    },
    {
      "stanza_id": "GP.C049",
      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.97",
          "line_number": 97,
          "text": "So hote he lovede, that by nightertale",
