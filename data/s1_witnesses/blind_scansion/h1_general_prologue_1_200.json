      "rhyme_scheme": "AA",
      "lines": [
        {
          "ref": "GP.103",
          "line_number": 103,
          "text": "And he was clad in cote and hood of grene;",
          "contested": false
        },
        {
          "ref": "GP.104",
          "line_number": 104,
          "text": "A sheef of pecok-arwes brighte and kene",
