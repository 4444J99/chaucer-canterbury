{
  "metadata": {
    "stratum": "S1",
    "holdout_flag": "EVALUATION_ONLY",
    "holdout_policy": "STRICT_EVALUATION_ONLY_NEVER_EXPOSED_TO_GENERATOR_OR_CALIBRATION",
    "set_id": "H1",
    "role": "Main recall set (riding-rhyme couplets)",
    "metrical_form": "riding_rhyme_couplet",
    "edition": "W. W. Skeat (ed.), The Complete Works of Geoffrey Chaucer, vol. 4, The Canterbury Tales: Text, 2nd ed., Oxford: Clarendon Press, 1900 (Project Gutenberg #22120).",
    "source_url": "https://github.com/GITenberg/Chaucer-s-Works-Volume-4--of-7----The-Canterbury-Tales_22120",
    "upstream_file": "22120-8.txt",
    "upstream_commit": "1e7f4c2ef672531d0676159202f2f9e2520e174c",
